# Browser-safe connection values (never put a service role key in VITE_*).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side connection values for authenticated server functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Used only by npm run db:migrate. Use a direct/session database connection.
LOVABLE_DB_MIGRATION_URL=postgresql://user:password@host:5432/postgres

# Optional: database server used to create isolated test databases; never your production server.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
