# Optional: Docker Compose works without this file or any API keys.
# For native development, defaults match the database in compose.dev.yaml.
DATABASE_URL=postgres://subscriptiq:subscriptiq@127.0.0.1:5432/subscriptiq

# Set false to skip demo initialization on a new, empty database.
SEED_DEMO=true

# Only enable behind HTTPS. Leave false for http://localhost:3000.
COOKIE_SECURE=false

# The production server defaults to 3000. Development runs the API at 3001
# and Vite at 3000; leave PORT unset when using npm run dev.
# PORT=3000

# Isolated regression databases are created and removed on this server.
# TEST_DATABASE_URL=postgres://subscriptiq:subscriptiq@127.0.0.1:5432/postgres
